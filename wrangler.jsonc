{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rclm-feedback-2026",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/painel", "/painel.html", "/painel/"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "rclm-feedback-2026",
    "migrations_dir": "migrations"
  }]
}
